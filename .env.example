# netbox-mcp-server environment variables.
#
# Copy to `.env` and fill in your values, or set them in your MCP client config
# (Claude Desktop, Claude Code, Cursor, Codex). `.env` is gitignored — never
# commit a token.
#
# The default transport is stdio. HTTP adds the loopback-only listener settings
# below. There is no server-side read-only switch or tool grouping:
# NETBOX_READONLY and NETBOX_TOOL_GROUPS were removed in 0.1.0 and do nothing.

# ---- Required ---------------------------------------------------------------

# Base URL of your NetBox instance. Do NOT include /api — the server adds it.
NETBOX_URL=https://netbox.example.com

# Inline API token. Create one in NetBox under your user menu > API Tokens > Add.
# Set exactly one of NETBOX_TOKEN and NETBOX_TOKEN_FILE. NETBOX_TOKEN is
# retained for client configs and local development.
NETBOX_TOKEN=your-api-token-here

# A readable regular file containing the API token. The server reads this file
# before every NetBox request, so a rotated file is used without restart. Do
# not set this together with NETBOX_TOKEN. Keep the file outside this repo.
# NETBOX_TOKEN_FILE=/run/secrets/netbox-token

# The token is the ONLY write control. Leave "Write enabled" UNCHECKED unless
# the assistant genuinely needs to change records, and constrain the token's
# object permissions to what it should see. NetBox enforces both, where no tool
# argument can reach them — which is why this server does not offer a switch of
# its own. Deletes cascade in NetBox and cannot be undone.
# ---- Optional ---------------------------------------------------------------

# Set to 1 to skip TLS certificate verification. Common for on-prem NetBox
# behind an internal CA — but it disables certificate validation entirely and
# exposes the token to anyone able to intercept the connection. Prefer
# installing the corporate root CA into the system trust store.
# NETBOX_INSECURE=0

# Streamable HTTP is opt-in and loopback-only until M6 adds gateway
# authentication. It serves MCP at /mcp and unauthenticated /healthz and
# /readyz probes. Gateway caller headers are never NetBox credentials.
# NETBOX_TRANSPORT=http
# NETBOX_HTTP_HOST=127.0.0.1
# NETBOX_HTTP_PORT=3000
