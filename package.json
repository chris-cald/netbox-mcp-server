{
  "name": "@zenixsolutions/netbox-mcp",
  "version": "0.2.0",
  "description": "Model Context Protocol server for the NetBox REST API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZenixSolutions/netbox-mcp-server.git"
  },
  "homepage": "https://github.com/ZenixSolutions/netbox-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/ZenixSolutions/netbox-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "netbox",
    "dcim",
    "ipam"
  ],
  "type": "module",
  "bin": {
    "netbox-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:skill": "node scripts/build-skill.mjs",
    "clean": "node -e \"for (const d of ['dist','coverage']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "eval": "vitest run --config vitest.eval.config.ts",
    "check:changelog": "node scripts/check-changelog.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.19.0",
    "jose": "^6.2.11",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.23.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
